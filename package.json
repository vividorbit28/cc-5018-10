{
  "name": "show-control",
  "version": "1.0.0",
  "private": true,
  "description": "Live show control switcher: frame-synchronous program output from independent inputs",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test test/unit.test.js",
    "verify": "node scripts/verify.js",
    "verify:fixtures": "node scripts/verify.js --fixtures ./test/fixtures",
    "fixtures": "node scripts/make_fixtures.js",
    "verify:ui": "node test/ui_click_check.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "ffmpeg-static": "5.3.0",
    "hls.js": "^1.7.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
